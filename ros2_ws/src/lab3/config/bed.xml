<root BTCPP_format="4" main_tree_to_execute="CleanBed">
  <BehaviorTree ID="CleanBed">
    <Sequence>
      <BedStep name="Inspect pillows and sheets" service="bed/inspect"/>
      <RetryUntilSuccessful num_attempts="3">
        <BedStep name="Remove stain" service="bed/clean"/>
      </RetryUntilSuccessful>
      <BedStep name="Replace linen and blanket" service="{replacement_service}"/>
    </Sequence>
  </BehaviorTree>
</root>
